#!/usr/bin/env python3
"""sleeper-pack: maakt en controleert Sleeper-apps. Alleen Python 3, geen pakketten nodig.

Elke app krijgt een launcher-bewijs: een code-afhankelijk controlecijfer dat alleen met de GEHEIME launcher-code te maken is.
De launcher op de server kent dezelfde code en weigert apps zonder kloppend bewijs. De code staat nooit in een pakket.

De launcher-code geef je op met --launcher-code, met de omgevingsvariabele SLEEPER_LAUNCHER_CODE, via --codes CODES.txt
(regel LAUNCHER_CODE=...) of je typt hem als er om gevraagd wordt.

  sleeper-pack codes [--out CODES.txt] [--apps naam1,naam2] [--force]
        maakt een nieuwe launcher-code (en eventueel installatiecodes voor apps die een eigen code moeten krijgen)
  sleeper-pack new <id> [--dir .]
  sleeper-pack pack <appmap> [--code EIGEN-CODE | --codes CODES.txt] [--no-proof] [--out dist]
  sleeper-pack build-all <bronmap> [--codes CODES.txt] [--out apps]
  sleeper-pack pack-launcher <launchermap> [--out apps]
  sleeper-pack index <repomap> [--out index.json]        (geen code nodig)
  sleeper-pack verify <pakket>
"""
import argparse
import getpass
import hashlib
import hmac
import json
import os
import re
import secrets as sx
import shutil
import sys
import zipfile

HERE = os.path.dirname(os.path.abspath(__file__))
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,30}$")
SKIP_DIRS = {".git", "__pycache__", ".github"}
ITERS = 200000
ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
BLOCKS, BLOCK_LEN = 8, 5
WORDS = """appel boom brood draak eiland fiets gitaar huis inkt jas kaars lamp maan noot olifant paard raket sneeuw tijger uil
vlinder wolk zebra zon berg bloem brug citroen dolfijn egel fluit gras hond ijs jaguar kaas leeuw mier nacht oceaan pinguin
regen slang taart vulkaan wind yoghurt zand bakker cactus druif engel fakkel geit hamer iglo jungle koffie lepel meloen nestje
oven pauw radijs schaap tomaat visser wortel zeil anker bos clown diamant emmer fontein gieter harp insect juweel kano ladder
mango ooievaar peer rups spiegel toren vijver wolf zwaan azijn beker dak eend fles goud hert jurk kiwi luik mosterd nagel
oester pijl riet steen tent vaas wafel aap bel cavia doos ezel foto gans hooi idee jacht kerk lint mus""".split()


def sha256(b):
    return hashlib.sha256(b).hexdigest()


# --- dit moet precies hetzelfde rekenen als engine.py op de server ---

def normalize_code(code):
    c = "".join(ch for ch in str(code).upper() if ch not in " -_\t\r\n")
    if len(c) != BLOCKS * BLOCK_LEN or any(ch not in ALPHABET for ch in c):
        raise ValueError("De launcher-code bestaat uit %d blokken van %d tekens (letters en cijfers), bijvoorbeeld XXXXX-XXXXX-..." % (BLOCKS, BLOCK_LEN))
    return c


def derive_key(code):
    return hashlib.sha256(("sleeper-launcher-code-v3:" + normalize_code(code)).encode()).hexdigest()


def canonical(man):
    return json.dumps({k: v for k, v in man.items() if k not in ("proof", "_verified")}, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()


def make_proof(man, key_hex):
    return hmac.new(bytes.fromhex(key_hex), canonical(man), "sha256").hexdigest()


# ---

def load_codes(path):
    out = {}
    if path and os.path.exists(path):
        for line in open(path, encoding="utf-8"):
            m = re.match(r"^([A-Za-z0-9_-]+)=(\S+)\s*$", line)
            if m:
                out[m.group(1)] = m.group(2)
    return out


def get_key(a):
    code = getattr(a, "launcher_code", "") or os.environ.get("SLEEPER_LAUNCHER_CODE", "") or load_codes(getattr(a, "codes", "")).get("LAUNCHER_CODE", "")
    if not code and sys.stdin.isatty():
        code = getpass.getpass("Launcher-code (blijft onzichtbaar): ")
    if not code:
        sys.exit("Geen launcher-code. Gebruik --launcher-code, de variabele SLEEPER_LAUNCHER_CODE of --codes CODES.txt.")
    try:
        return derive_key(code)
    except ValueError as e:
        sys.exit(str(e))


def fingerprint(code):
    h = hashlib.sha256(("fp:" + derive_key(code)).encode()).hexdigest()[:12]
    return "-".join(h[i:i + 4] for i in range(0, 12, 4))


def new_launcher_code():
    return "-".join("".join(sx.choice(ALPHABET) for _ in range(BLOCK_LEN)) for _ in range(BLOCKS))


def cmd_codes(a):
    if os.path.exists(a.out) and not a.force:
        sys.exit("%s bestaat al. Gebruik --force om te overschrijven." % a.out)
    code = new_launcher_code()
    lines = [
        "SLEEPER - CODES", "=" * 60,
        "LAUNCHER_CODE   GEHEIM. Alleen voor jou en je app-makers (ook AI die je apps laat maken). Elke app krijgt hiermee een bewijs;",
        "                de launcher op je server kent dezelfde code en weigert apps zonder kloppend bewijs.",
        "                Typ hem in op de server bij de eerste start van 'sudo sleeper' (of via Instellingen > Beveiliging).",
        "APP_CODE_<app>  Optioneel: een eigen installatiecode voor een app die je extra wilt beveiligen (die vul je in bij installeren).",
        "", "Bewaar dit bestand alleen offline (eigen pc of wachtwoordmanager), nooit op de server of op GitHub.",
        "Je beheerderswachtwoord kies je zelf bij de eerste start van de launcher.", "-" * 60,
        "LAUNCHER_CODE=%s" % code,
        "VINGERAFDRUK=%s   (de launcher toont dit na het typen van de code; zo weet je dat je hem goed typte)" % fingerprint(code),
    ]
    for i in [x.strip() for x in a.apps.split(",") if x.strip()]:
        lines.append("APP_CODE_%s=%s" % (i, "-".join(sx.choice(WORDS) for _ in range(4)) + "-%02d" % sx.randbelow(100)))
    lines.append("")
    with open(a.out, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    os.chmod(a.out, 0o600)
    print("Codes opgeslagen in %s" % a.out)


def build_package(man, files, a, app_id):
    no_proof = getattr(a, "no_proof", False)
    key = None if no_proof else get_key(a)
    code = getattr(a, "code", "") or load_codes(getattr(a, "codes", None)).get("APP_CODE_%s" % app_id, "")
    man.pop("secure", None)
    man.pop("launcher_key", None)
    man["files"] = {k: sha256(v) for k, v in sorted(files.items())}
    man.setdefault("engine_min", 1)
    man.setdefault("requires", [])
    man.pop("install_code", None)
    man.pop("proof", None)
    if code:
        salt = os.urandom(16)
        man["install_code"] = {"salt": salt.hex(), "iters": ITERS, "hash": hashlib.pbkdf2_hmac("sha256", code.encode(), salt, ITERS).hex()}
    if key:
        man["proof"] = make_proof(man, key)
    raw = json.dumps(man, indent=2, sort_keys=True, ensure_ascii=False).encode()
    os.makedirs(a.out, exist_ok=True)
    out = os.path.join(a.out, "%s-%s%s.sleeperapp" % (man["id"], man["version"], "" if key else "-zonder-bewijs"))
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("app.json", raw)
        for name, data in files.items():
            z.writestr(name, data)
    print("Gemaakt: %s  [%s%s]" % (out, "launcher-bewijs" if key else "ZONDER launcher-bewijs: alleen te installeren in de ontwikkelaarsmodus", ", eigen installatiecode" if code else ""))
    return out


def collect(appdir):
    files = {}
    for root, dirs, names in os.walk(appdir):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        for n in names:
            full = os.path.join(root, n)
            rel = os.path.relpath(full, appdir).replace(os.sep, "/")
            if rel == "app.json" or n.endswith((".pyc", ".sleeperapp")) or n == ".engine":
                continue
            files[rel] = open(full, "rb").read()
    return files


def pack_app(appdir, a):
    man = json.load(open(os.path.join(appdir, "app.json")))
    for k in ("id", "name", "version"):
        if not man.get(k):
            sys.exit("app.json mist '%s'" % k)
    if not ID_RE.match(man["id"]):
        sys.exit("Ongeldige app-id.")
    files = collect(appdir)
    if "app.py" not in files:
        sys.exit("De app mist app.py.")
    return build_package(man, files, a, man["id"])


def cmd_new(a):
    if not ID_RE.match(a.id):
        sys.exit("Gebruik een korte naam: kleine letters, cijfers en streepjes (bijv. mijn-app).")
    dst = os.path.join(a.dir, a.id)
    shutil.copytree(os.path.join(HERE, "template-app"), dst)
    p = os.path.join(dst, "app.json")
    m = json.load(open(p))
    m["id"], m["name"] = a.id, a.id.replace("-", " ").title()
    json.dump(m, open(p, "w"), indent=2, ensure_ascii=False)
    print("Nieuwe app in %s. Pas app.json en app.py aan en maak er daarna een pakket van met 'pack'." % dst)


def cmd_pack(a):
    pack_app(a.appdir, a)


def cmd_build_all(a):
    for name in sorted(os.listdir(a.srcdir)):
        d = os.path.join(a.srcdir, name)
        if os.path.isfile(os.path.join(d, "app.json")):
            pack_app(d, a)


LAUNCHER_FILES = ("launcher.py", "engine.py", "ui.py", "sysinfo.py")


def cmd_pack_launcher(a):
    src = open(os.path.join(a.launcherdir, "engine.py"), encoding="utf-8").read()
    m = re.search(r'^VERSION = "([0-9.]+)"', src, re.M)
    if not m:
        sys.exit("Kan VERSION niet vinden in engine.py")
    files = {n: open(os.path.join(a.launcherdir, n), "rb").read() for n in LAUNCHER_FILES}
    man = {"id": "launcher", "name": "Sleeper Launcher", "version": m.group(1), "kind": "launcher",
           "summary": "De Sleeper Launcher zelf (basis).", "description": "Nieuwe versie van de launcher.", "author": "jij", "requires": []}
    build_package(man, files, a, "launcher")


def cmd_index(a):
    apps = {}
    base = os.path.abspath(a.repo)
    vt = lambda v: tuple(int(x) for x in v.split("."))
    for root, dirs, names in os.walk(base):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        for n in names:
            if not n.endswith(".sleeperapp"):
                continue
            full = os.path.join(root, n)
            data = open(full, "rb").read()
            man = json.loads(zipfile.ZipFile(full).read("app.json"))
            e = {"kind": man.get("kind", "app"), "id": man["id"], "name": man.get("name", man["id"]), "version": str(man["version"]),
                 "summary": man.get("summary", ""), "description": man.get("description", ""), "author": man.get("author", ""),
                 "requires": man.get("requires", []), "needs_code": bool(man.get("install_code")),
                 "path": os.path.relpath(full, base).replace(os.sep, "/"), "sha256": sha256(data), "size": len(data)}
            cur = apps.get(e["id"])
            if cur is None or vt(e["version"]) > vt(cur["version"]):
                apps[e["id"]] = e
    out = a.out or os.path.join(base, "index.json")
    json.dump({"apps": [apps[k] for k in sorted(apps)]}, open(out, "w"), indent=2, ensure_ascii=False)
    print("Index met %d pakket(ten): %s" % (len(apps), out))


def cmd_verify(a):
    z = zipfile.ZipFile(a.pkg)
    man = json.loads(z.read("app.json"))
    good = True
    if not isinstance(man.get("proof"), str):
        good = False
        print("Geen launcher-bewijs in het pakket.")
    elif not hmac.compare_digest(man["proof"], make_proof(man, get_key(a))):
        good = False
        print("Het launcher-bewijs klopt niet (andere launcher-code, of het pakket is aangepast).")
    for n, h in man["files"].items():
        if sha256(z.read(n)) != h:
            good = False
            print("Bestand aangepast:", n)
    print("%s %s: %s" % (man["id"], man["version"], "OK" if good else "ONGELDIG"))
    sys.exit(0 if good else 1)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("codes"); p.add_argument("--out", default="CODES.txt"); p.add_argument("--apps", default="")
    p.add_argument("--force", action="store_true"); p.set_defaults(f=cmd_codes)
    p = sub.add_parser("new"); p.add_argument("id"); p.add_argument("--dir", default="."); p.set_defaults(f=cmd_new)

    def common(p, out):
        p.add_argument("--codes", default=""); p.add_argument("--launcher-code", dest="launcher_code", default="")
        p.add_argument("--out", default=out)
        p.add_argument("--no-proof", dest="no_proof", action="store_true", help="geen launcher-code nodig; de app is dan niet gecontroleerd (alleen ontwikkelaarsmodus)")

    p = sub.add_parser("pack"); p.add_argument("appdir"); p.add_argument("--code", default=""); common(p, "dist"); p.set_defaults(f=cmd_pack)
    p = sub.add_parser("build-all"); p.add_argument("srcdir"); common(p, "apps"); p.set_defaults(f=cmd_build_all, code="")
    p = sub.add_parser("pack-launcher"); p.add_argument("launcherdir"); common(p, "apps"); p.set_defaults(f=cmd_pack_launcher, code="")
    p = sub.add_parser("index"); p.add_argument("repo"); p.add_argument("--out", default=""); p.set_defaults(f=cmd_index)
    p = sub.add_parser("verify"); p.add_argument("pkg"); p.add_argument("--codes", default=""); p.add_argument("--launcher-code", dest="launcher_code", default="")
    p.set_defaults(f=cmd_verify)
    a = ap.parse_args()
    a.f(a)


if __name__ == "__main__":
    main()
